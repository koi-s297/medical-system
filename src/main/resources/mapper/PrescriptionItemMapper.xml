<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.medicalsystem.mapper.PrescriptionItemMapper">

    <resultMap id="BaseResultMap" type="com.example.medicalsystem.entity.PrescriptionItem">
        <id column="id" property="id" />
        <result column="presc_id" property="prescId" />
        <result column="medicine_id" property="medicineId" />
        <result column="quantity" property="quantity" />
        <result column="unit_price" property="unitPrice" />
        <result column="created_at" property="createdAt" />
    </resultMap>

    <sql id="Base_Column_List">
        id, presc_id, medicine_id, quantity, unit_price, created_at
    </sql>

</mapper>
